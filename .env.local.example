# ─── Sanity CMS ────────────────────────────────────────────────────────────
# 1. Go to https://sanity.io → create a project named "portfolio-hamza"
# 2. Copy the Project ID from the project dashboard
# 3. Go to Settings → API → Tokens → create a token with Editor role
# 4. Copy this file to .env.local and fill in the values below

NEXT_PUBLIC_SANITY_PROJECT_ID=your-project-id-here
NEXT_PUBLIC_SANITY_DATASET=production
NEXT_PUBLIC_SANITY_API_VERSION=2024-01-01
SANITY_API_TOKEN=your-editor-token-here
